  "plan": "DESIGN.md#源码借鉴与-mod-发布路线2026-10-15",
  "findings": [
    {
      "project": "Terra",
      "file": "TerraAIMod/UI/ChatPanel.cs",
      "line": 64,
      "finding": "Sender, body, role/alignment are modeled separately; add/remove message bubbles incrementally. Adapt this idea to current 80-line bound and preserve scroll position."
    },
    {
      "project": "Terra",
      "file": "TerraAIMod/UI/TerraUIState.cs",
      "line": 355,
      "finding": "UI command routing selects terras.First(); not a full selected-companion UI."
    },
    {
      "project": "Terra",
      "file": "TerraAIMod/UI/InputField.cs",
      "line": 103,
      "finding": "Input is read during Update and Enter is handled directly; keep our engine chat interception and composition-state handling."
    },
    {
      "project": "Terra",
      "file": "TerraAIMod/Action/ActionExecutor.cs",
      "line": 141,
      "finding": "API-key presence gates LLM usage. A local no-key service needs explicit capability/availability handling instead."
    },
    {
      "project": "Terra",
      "file": "TerraAIMod/Action/ActionExecutor.cs",
      "line": 412,
      "finding": "A concurrent result queue is drained on the game thread. No command/session token validation found in this file; retain our existing stale-result checks."
    },
    {
      "project": "Terra",
      "file": "TerraAIMod/NPCs/TerraNPC.cs",
      "line": 188,
      "finding": "SaveData/LoadData exist, but reviewed class sets townNPC=false and has no NeedSaving override; inventory is not serialized here. Persistence is not runtime-verified."
    },
    {
      "project": "TerraGuardians",
      "file": "Interfaces/Orders/OrdersOrders.cs",
      "line": 10,
      "finding": "Follow and Wait are direct code-driven orders; adapt as zero-model calls into a shared command service."
    },
    {
      "project": "TerraGuardians",
      "file": "Behaviors/FollowLeaderBehavior.cs",
      "line": 22,
      "finding": "Stuck handling escalates to pathing and then pulling back toward owner; adapt bounded recovery to our NPC collision model."
    },
    {
      "project": "TerraGuardians",
      "file": "Interfaces/GroupMembersInterface.cs",
      "line": 13,
      "finding": "Compact companion heads and status bars provide a useful HUD pattern; our invulnerable prototype should show real state rather than misleading combat bars."
    },
    {
      "project": "TerraGuardians",
      "file": "Interfaces/CompanionSelectionInterface.cs",
      "line": 159,
      "finding": "Portrait/name/personality and call/dismiss controls form a useful profile page. Its rename flow opens native chat; use our own input widget instead."
    },
    {
      "project": "TerraGuardians",
      "file": "Companion.cs",
      "line": 20,
      "finding": "Companion inherits Player; build.txt depends on nterrautils. Porting inventory/combat/rendering wholesale is a major architecture change."
    },
    {
      "project": "TerraGuardians",
      "file": "PlayerMod.cs",
      "line": 2687,
      "finding": "Roster and followers are stored in player data; SystemMod also has world data hooks. Our learned preferences must remain world-scoped."
    }
  ],
