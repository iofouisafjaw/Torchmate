    "expect": { "end": ["reply", "forward"], "text_has": ["NPC", "商人"], "text_lacks": ["白天 10"], "max_model_calls": 4 } },
  { "id": "look-npcs", "say": "还有哪些NPC没来，要怎么让他们来",
