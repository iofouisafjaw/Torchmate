// 同伴测试题。每题：玩家说的话（say）、一个简化的世界（world）、期望（expect）。
// expect 里每一项都是可选的：
//   end        结束方式：reply 回复 / forward 交给资料库 / ask 反问 / build 盖房 / platform 搭平台 / stop 被程序停下
//   calls      必须调用的工具，"craft:工作台" 表示参数里含"工作台"；no_calls 不许调用的
//   first      第一步必须是哪个工具
//   text_has   最后一句话至少提到其中一个词；text_lacks 一个都不能有
//   max_model_calls  最多调用模型几次
//   bag_has    结束时背包（或已放下）至少有；near 身边必须放着的制作站
//   spawns_real  作弊生成出了真实存在的物品
//   kb_has     交给资料库后，资料库的回答要提到其中一个词
// 世界默认：森林白天、5 棵树、背包空、只有向导、作弊关。
[
  // 0.10.25: terminal world-cheat handoffs; offline adapter does not simulate native effects.
  { "id": "cheat-world-time", "say": "时间改成21:00", "world": { "cheat": true },
    "expect": { "end": ["cheat_world"], "calls": ["cheat_world:21:00"], "max_model_calls": 2 } },
  { "id": "cheat-world-rain", "say": "天气改成下雨", "world": { "cheat": true },
    "expect": { "end": ["cheat_world"], "calls": ["cheat_world:rain"], "max_model_calls": 2 } },
  { "id": "cheat-world-boss", "say": "召唤克眼", "world": { "cheat": true },
    "expect": { "end": ["cheat_world"], "calls": ["cheat_world:eye"], "max_model_calls": 2 } },
  { "id": "cheat-world-spawn", "say": "把世界出生点设在这里", "world": { "cheat": true },
    "expect": { "end": ["cheat_world"], "calls": ["cheat_world:here"], "max_model_calls": 2 } },
  { "id": "cheat-world-off", "say": "天气改成晴天", "world": { "cheat": false },
    "expect": { "end": ["reply", "ask"], "no_calls": ["cheat_world", "spawn_item"], "max_model_calls": 2 } },
  { "id": "cheat-world-question", "say": "怎么召唤克眼", "world": { "cheat": true },
    "expect": { "end": ["forward"], "no_calls": ["cheat_world"], "max_model_calls": 2 } },
  { "id": "cheat-world-negated", "say": "不要召唤克眼", "world": { "cheat": true },
    "expect": { "end": ["reply"], "no_calls": ["cheat_world", "spawn_item"], "max_model_calls": 2 } },

  // gardening只测程序交接，不模拟生长、采收或物品生成。
  { "id": "garden-acorns", "say": "帮我种3颗橡实，先给我看计划",
    "expect": { "end": ["garden"], "no_calls": ["chop", "mine", "place", "spawn_item"], "max_model_calls": 2 } },
  { "id": "garden-herbs", "say": "帮我在附近花盆种5株太阳花，先确认再种",
    "expect": { "end": ["garden"], "no_calls": ["craft", "place", "spawn_item"], "max_model_calls": 2 } },
  { "id": "garden-harvest", "say": "采收附近已开花的草药，幼苗别动，先列计划",
    "expect": { "end": ["garden"], "no_calls": ["mine", "chop", "spawn_item"], "max_model_calls": 2 } },
  { "id": "garden-potion-chain", "say": "规划合成3瓶再生药水，优先背包和箱子，缺草药再采开花的",
    "expect": { "end": ["craft_chain"], "no_calls": ["garden", "mine", "spawn_item", "craft", "chest_take"], "max_model_calls": 2 } },
  // 克眼准备只测模型交接；程序场景见 ArenaTests，不冒充地形或Buff验收。
  { "id": "arena-eye-prep", "say": "帮我准备打克眼，先列出竞技场和药水缺什么，确认后再动手",
    "expect": { "end": ["prepare_eye"], "no_calls": ["craft", "place", "spawn_item", "chop", "mine", "buy"], "max_model_calls": 2 } },
  { "id": "arena-eye-formal-name", "say": "准备打克苏鲁之眼，需要平台、篝火、心灯和药水，先给我看计划",
    "expect": { "end": ["prepare_eye"], "no_calls": ["craft", "place", "structure", "spawn_item"], "max_model_calls": 2 } },
  { "id": "arena-eye-boxes", "say": "用背包和旁边箱子的材料帮我准备打克眼，不够先告诉我",
    "world": { "bag": { "木材": 80 }, "chests": { "木材": 150 } },
    "expect": { "end": ["prepare_eye"], "no_calls": ["chest_take", "craft", "place", "spawn_item"], "max_model_calls": 2 } },
  // 挖掘／探路只测工具交接；地形行为由共享控制器测试，实机由玩家验收。
  { "id": "expedition-underground", "say": "帮我从这里挖到地下层，发现矿和危险就告诉我",
    "expect": { "end": ["expedition"], "calls": ["expedition:underground"], "no_calls": ["mine", "spawn_item", "control"], "max_model_calls": 2 } },
  { "id": "expedition-tunnel", "say": "往下挖一条32格深的通道，用背包的镐就行",
    "expect": { "end": ["expedition"], "calls": ["expedition:tunnel"], "no_calls": ["mine", "spawn_item"], "max_model_calls": 2 } },
  { "id": "expedition-scout", "say": "去我面前探探，报告沿路矿、箱子和危险，然后回来",
    "expect": { "end": ["expedition"], "calls": ["expedition:scout"], "no_calls": ["mine", "chest_take", "spawn_item"], "max_model_calls": 2 } },
  // 只核对定位工具交接；离线环境没有真实地图，不伪造坐标或标记。
  { "id": "locate-ore", "say": "帮我看看最近的铁矿在什么方向，标到地图上，我暂时不挖",
    "expect": { "end": ["locate"], "calls": ["locate:铁矿"], "no_calls": ["mine", "craft", "chest_take", "spawn_item"], "max_model_calls": 2 } },
  { "id": "locate-chest", "say": "附近哪里有箱子，给我标个位置，不要拿东西",
    "expect": { "end": ["locate"], "calls": ["locate:箱子"], "no_calls": ["chest_take", "chest_put", "spawn_item"], "max_model_calls": 2 } },
  { "id": "locate-bed", "say": "我之前设置出生点的床在什么方向，标在地图上给我看看",
    "expect": { "end": ["locate"], "calls": ["locate:我的床"], "no_calls": ["place", "craft", "spawn_item"], "max_model_calls": 2 } },
  // 只测模型交接；不在离线工具世界伪造战斗伤害。
  { "id": "combat-protect", "say": "跟着我，帮我挡一挡身边的小怪，保护我",
    "expect": { "end": ["combat"], "calls": ["combat:protect"], "no_calls": ["mine", "chop", "spawn_item"], "max_model_calls": 2 } },
  { "id": "combat-clear", "say": "把周围的小怪清了，别碰城镇NPC",
    "expect": { "end": ["combat"], "calls": ["combat:clear"], "no_calls": ["mine", "chop", "spawn_item"], "max_model_calls": 2 } },
  { "id": "combat-stop", "say": "先别打了，停止攻击附近怪物",
    "expect": { "end": ["combat"], "calls": ["combat:off"], "no_calls": ["mine", "chop", "spawn_item"], "max_model_calls": 2 } },
  // 完整链只测模型交接；成品和采集执行由共享程序核心测试核验。
  { "id": "chain-iron-suit", "say": "帮我准备一套铁盔甲，先算材料，确认后再执行",
    "expect": { "end": ["craft_chain"], "calls": ["craft_chain:铁"], "no_calls": ["craft", "mine", "chop", "place"], "max_model_calls": 2 } },
  { "id": "chain-furnace", "say": "规划完整合成链，制作两个熔炉，缺材料再采集",
    "expect": { "end": ["craft_chain"], "calls": ["craft_chain:熔炉"], "no_calls": ["craft", "mine", "chop", "place"], "max_model_calls": 2 } },
  { "id": "chain-anvil-boxes", "say": "做一个铁砧，先看背包和附近箱子，不够再采集，确认后做",
    "world": { "bag": { "铁锭": 2 }, "chests": { "铁锭": 3 }, "near": ["工作台"] },
    "expect": { "end": ["craft_chain"], "calls": ["craft_chain:铁砧"], "no_calls": ["craft", "chest_take", "mine", "chop", "place"], "max_model_calls": 3 } },
  // ---------------- 知识问题：应该交给资料库，而且资料库要答到点上 ----------------
  { "id": "kb-soul-of-light", "say": "光明之魂是啥",
    "expect": { "end": ["forward"], "max_model_calls": 3, "kb_has": ["光明之魂"] } },
  { "id": "kb-boss-drops", "say": "克苏鲁之眼掉落什么",
    "expect": { "end": ["forward"], "max_model_calls": 3, "kb_has": ["掉落", "掉"] } },
  { "id": "kb-calamity-drops", "say": "荒漠灾虫掉落什么装备",
    "expect": { "end": ["forward"], "max_model_calls": 3 } },
  { "id": "kb-how-to-use", "say": "史莱姆钩如何使用",
