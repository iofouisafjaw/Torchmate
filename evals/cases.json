                   { "name": "月亮领主", "mod": "Terraria", "type": "boss", "progression": 18 },
                   { "name": "至尊灾厄", "mod": "CalamityMod", "type": "boss", "progression": 23 } ],
    "expect": { "end": ["forward"], "max_model_calls": 3, "kb_has": ["至尊灾厄", "月亮领主"] } },
  { "id": "kb-first-boss", "say": "我们这个世界该去打的第一个boss是哪个",
    "expect": { "end": ["forward"], "max_model_calls": 3 } },
  { "id": "kb-next-step", "say": "下一步该干啥",
    "expect": { "end": ["forward", "reply"], "max_model_calls": 4 } },
  { "id": "kb-how-to-fight", "say": "克苏鲁之眼怎么打",
    "expect": { "end": ["forward"], "max_model_calls": 3 } },

  // ---------------- 查询：查一次就回答，不要重复查 ----------------
