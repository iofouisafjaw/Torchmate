    "world": { "bag": { "木材": 10 } },
    "expect": { "end": ["reply"], "calls": ["house_materials"], "text_has": ["木"], "max_model_calls": 3 } },

  // ---------------- 合成：要能自己补齐中间步骤 ----------------
